{
    "compilerOptions": {
      "declaration": false,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "esModuleInterop": true,
      "lib": ["es2022", "dom"],
      "mapRoot": "dist",
      "module": "commonjs",
      "moduleResolution": "node",
      "outDir": "dist",
      "rootDir": "src",
      "sourceMap": true,
      "target": "es2022",
      "typeRoots": [
        "node_modules/@types"
      ]
    },
    "include": ["src/**/*"]
}
